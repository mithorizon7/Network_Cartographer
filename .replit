modules = ["nodejs-24", "web", "postgresql-16"]
run = "bash script/replit-start.sh"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[packager]
language = "nodejs"

[packager.features]
# The verified deployment bootstrap installs dependencies on patched Node first.
enabledForHosting = false
guessImports = false

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"
HOST = "0.0.0.0"
# Use the patched Node trust store, not the inherited OpenSSL CA override.
NODE_OPTIONS = "--use-bundled-ca"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "script/replit-start.sh"]
build = ["bash", "script/replit-build.sh"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash script/replit-start.sh"
waitForPort = 5000
